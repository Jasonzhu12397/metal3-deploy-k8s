# Copy to .env and fill in real values. NEVER commit the real .env file,
# and never put SSH private keys or the cluster CA private key directly
# into this file -- reference a secret manager / mounted Secret path
# instead. (BMC passwords are the one secret this app does store, but
# encrypted -- see BMC_ENCRYPTION_KEY below; the key itself still belongs
# in a secret manager, not committed here.)

ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://metal3:metal3@localhost:5432/metal3_deploy
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

SECRET_KEY=replace-with-a-long-random-value

# Seed admin account, created automatically on first startup if the users
# table is empty. Set ADMIN_PASSWORD here for anything beyond a throwaway
# local run -- if left unset, a random password is generated and printed
# ONCE to the startup logs (`docker compose logs api`), which is safer for
# a quick local test but easy to lose track of.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Fernet key for encrypting stored BMC passwords at rest (services/crypto.py).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This key is the actual secret -- store it in a real secret manager in
# production, not this file. Losing it makes every previously-encrypted
# BMC credential permanently unrecoverable (no backdoor, by design).
# Comma-separate multiple keys (newest first) during a rotation.
BMC_ENCRYPTION_KEY=

# Path to the kubeconfig of the management cluster (ephemeral PXE node
# during bootstrap, or a permanent CAPI management cluster afterwards).
MGMT_KUBECONFIG_PATH=/secrets/kubeconfig/config
CAPI_NAMESPACE=metal3

BMH_READY_TIMEOUT=1800
CLUSTER_PROVISION_TIMEOUT=7200

# Only relevant if you enable pivot_to_self_hosting on a cluster (moving
# CAPI management from an ephemeral bootstrap node to the target cluster
# once it's self-hosting -- see backend/app/services/pivot.py). The
# worker image already bundles clusterctl at /usr/local/bin/clusterctl,
# so this rarely needs overriding.
CLUSTERCTL_BINARY_PATH=clusterctl
PIVOT_TIMEOUT=300

# Only relevant for addons wired up in backend/app/services/addons.py's
# INSTALL_METHODS (kubectl apply / helm install against the target
# cluster during the installing_addons deployment phase, e.g. KubeVirt/
# Kube-OVN). The worker image already bundles both at /usr/local/bin.
KUBECTL_BINARY_PATH=kubectl
HELM_BINARY_PATH=helm
ADDON_INSTALL_TIMEOUT=600
