# Copy to secret.yaml, fill in real values, and DO NOT commit secret.yaml
# to git (it's already covered by the repo-root .gitignore pattern for
# *.yaml under deploy/k8s if you add one -- or just keep it out of the
# repo entirely and apply it straight from a secrets manager / CI pipeline).
apiVersion: v1
kind: Secret
metadata:
  name: metal3-deploy-secrets
  namespace: metal3
type: Opaque
stringData:
  SECRET_KEY: "REPLACE_WITH_A_LONG_RANDOM_VALUE"
  # Leave empty to get a random one generated and printed once to the api
  # pod's logs on first startup (kubectl logs -n metal3 deploy/metal3-deploy-api);
  # set it explicitly for anything beyond a throwaway first boot.
  ADMIN_PASSWORD: ""
  # Generate with:
  #   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
  # This is the key that decrypts every stored BMC password -- treat it
  # with at least as much care as SECRET_KEY. Losing it makes every
  # previously-encrypted BMC credential permanently unrecoverable.
  BMC_ENCRYPTION_KEY: "REPLACE_WITH_A_GENERATED_FERNET_KEY"
  # Only used by postgres.yaml's self-contained fallback Postgres --
  # DELETE this key (and don't apply postgres.yaml) if you're pointing
  # DATABASE_URL at a managed instance instead. Whatever you set this to
  # MUST match the password embedded in DATABASE_URL below.
  POSTGRES_PASSWORD: "REPLACE_WITH_A_STRONG_PASSWORD"
  DATABASE_URL: "postgresql+asyncpg://metal3:REPLACE_WITH_A_STRONG_PASSWORD@postgres.metal3.svc:5432/metal3_deploy"
  REDIS_URL: "redis://redis.metal3.svc:6379/0"
  CELERY_BROKER_URL: "redis://redis.metal3.svc:6379/1"
  CELERY_RESULT_BACKEND: "redis://redis.metal3.svc:6379/2"
