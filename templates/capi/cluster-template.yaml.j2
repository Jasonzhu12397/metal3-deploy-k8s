{# CAPI + Metal3 manifests for the target production cluster.
   `cluster` is expected to look roughly like:
   {
     name, namespace, control_plane_count, control_plane_endpoint,
     pod_cidr, service_cidr, k8s_version,
     worker_pools: [{name, count, node_labels: [...]}]
   }

   Targets the Cluster API v1beta2 contract (Cluster/KubeadmControlPlane/
   MachineDeployment/KubeadmConfigTemplate) and CAPM3 v1beta2
   (Metal3Cluster/Metal3MachineTemplate) -- v1beta1 on these types is
   marked deprecated as of CAPI v1.11.0 (storage version moved to
   v1beta2) and CAPM3 v1.13.0 respectively. See README's "Known API
   version debt" section for the full compatibility picture and why
   OpenStack/vSphere/KubeVirt's own provider-specific resources (as
   opposed to the CAPI-core resources shared across all providers, which
   ARE updated here) are handled separately.

   Two structural changes from v1beta1, not just version-string bumps:
   - infrastructureRef/controlPlaneRef/configRef went from
     {apiVersion: "<group>/<version>", kind, name} to
     {apiGroup: "<group>", kind, name} -- no version in the reference at
     all; the controller looks up the right version from the target
     CRD's own contract labels.
   - kubeletExtraArgs went from a map ({cloud-provider: ""}) to a list of
     {name, value} objects -- and the field is invalid (minItems: 1) if
     present but empty, so every args block below is wrapped in an
     `{% if %}` that omits the key entirely rather than rendering `[]`.
#}
apiVersion: cluster.x-k8s.io/v1beta2
kind: Cluster
metadata:
  name: {{ cluster.name }}
  namespace: {{ cluster.namespace }}
spec:
  clusterNetwork:
    pods:
      cidrBlocks: [{{ cluster.pod_cidr | default('192.168.0.0/16') }}]
    services:
      cidrBlocks: [{{ cluster.service_cidr | default('10.96.0.0/12') }}]
  controlPlaneRef:
    apiGroup: controlplane.cluster.x-k8s.io
    kind: KubeadmControlPlane
    name: {{ cluster.name }}-control-plane
  infrastructureRef:
    apiGroup: infrastructure.cluster.x-k8s.io
    kind: Metal3Cluster
    name: {{ cluster.name }}
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: Metal3Cluster
metadata:
  name: {{ cluster.name }}
  namespace: {{ cluster.namespace }}
spec:
  controlPlaneEndpoint:
    host: {{ cluster.control_plane_endpoint }}
    port: {{ cluster.control_plane_port | default(6443) }}
  # v1beta2 renamed this from the old noCloudProvider (inverted boolean,
  # deprecated even back in v1beta1) to cloudProviderEnabled -- false
  # here means the same thing noCloudProvider: true used to.
  cloudProviderEnabled: false
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: Metal3MachineTemplate
metadata:
  name: {{ cluster.name }}-control-plane
  namespace: {{ cluster.namespace }}
spec:
  template:
    spec:
      image:
        url: {{ cluster.image_url | default('http://images.local/your-os-image.qcow2') }}
        # required in the v1beta2 CRD (unlike v1beta1, where it was
        # optional) -- but still allows an empty string, e.g. for
        # live-iso/oci:// image references that don't need one.
        checksum: "{{ cluster.image_checksum | default('') }}"
{% if cluster.image_checksum_type is defined and cluster.image_checksum_type %}
        checksumType: {{ cluster.image_checksum_type }}
{% endif %}
{% if cluster.image_format is defined and cluster.image_format %}
        diskFormat: {{ cluster.image_format }}
{% endif %}
      dataTemplate:
        name: {{ cluster.name }}-controlplane-template
---
apiVersion: controlplane.cluster.x-k8s.io/v1beta2
kind: KubeadmControlPlane
metadata:
  name: {{ cluster.name }}-control-plane
  namespace: {{ cluster.namespace }}
spec:
  replicas: {{ cluster.control_plane_count | default(3) }}
  version: {{ cluster.k8s_version | default('v1.29.0') }}
  machineTemplate:
    spec:
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: Metal3MachineTemplate
        name: {{ cluster.name }}-control-plane
  kubeadmConfigSpec:
    initConfiguration:
      nodeRegistration:
        kubeletExtraArgs:
          - name: cloud-provider
            value: ""
{% if cluster.control_plane_reserved_cpus is defined %}
          - name: reserved-cpus
            value: "{{ cluster.control_plane_reserved_cpus }}"
          - name: cpu-manager-policy
            value: "{{ cluster.control_plane_cpu_manager_policy | default('static') }}"
          - name: topology-manager-policy
            value: "{{ cluster.control_plane_topology_manager_policy | default('single-numa-node') }}"
{% endif %}
    clusterConfiguration:
      apiServer:
        extraArgs:
          - name: cloud-provider
            value: ""
{% if cluster.control_plane_hugepage_count_1gb is defined and cluster.control_plane_hugepage_count_1gb %}
    preKubeadmCommands:
      - "echo {{ cluster.control_plane_hugepage_count_1gb }} > /sys/kernel/mm/hugepages/hugepages-1048576kB/nr_hugepages"
{% if cluster.control_plane_hugepage_count_2mb is defined and cluster.control_plane_hugepage_count_2mb %}
      - "echo {{ cluster.control_plane_hugepage_count_2mb }} > /sys/kernel/mm/hugepages/hugepages-2048kB/nr_hugepages"
{% endif %}
{% endif %}
{% if cluster.allow_workloads_on_control_plane | default(false) %}
    postKubeadmCommands:
      # Single-node (or otherwise workload-bearing) control plane: drop the
      # NoSchedule taint kubeadm applies by default so pods can actually
      # run here. Runs on each control-plane node against its own kubelet
      # identity, so it's safe even if control_plane_count > 1.
      - "kubectl --kubeconfig /etc/kubernetes/admin.conf taint node $(hostname) node-role.kubernetes.io/control-plane- --overwrite || true"
{% endif %}
{% for pool in cluster.worker_pools %}
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: Metal3MachineTemplate
metadata:
  name: {{ cluster.name }}-{{ pool.name }}
  namespace: {{ cluster.namespace }}
spec:
  template:
    spec:
      image:
        url: {{ cluster.image_url | default('http://images.local/your-os-image.qcow2') }}
        # required in the v1beta2 CRD (unlike v1beta1, where it was
        # optional) -- but still allows an empty string, e.g. for
        # live-iso/oci:// image references that don't need one.
        checksum: "{{ cluster.image_checksum | default('') }}"
{% if cluster.image_checksum_type is defined and cluster.image_checksum_type %}
        checksumType: {{ cluster.image_checksum_type }}
{% endif %}
{% if cluster.image_format is defined and cluster.image_format %}
        diskFormat: {{ cluster.image_format }}
{% endif %}
      dataTemplate:
        name: {{ cluster.name }}-{{ pool.name }}-template
---
apiVersion: bootstrap.cluster.x-k8s.io/v1beta2
kind: KubeadmConfigTemplate
metadata:
  name: {{ cluster.name }}-{{ pool.name }}
  namespace: {{ cluster.namespace }}
spec:
  template:
    spec:
      joinConfiguration:
        nodeRegistration:
{% if (pool.node_labels is defined and pool.node_labels) or (pool.reserved_cpus is defined and pool.reserved_cpus) %}
          kubeletExtraArgs:
{% if pool.node_labels is defined and pool.node_labels %}
            - name: node-labels
              value: "{{ pool.node_labels | join(',') }}"
{% endif %}
{% if pool.reserved_cpus is defined and pool.reserved_cpus %}
            - name: reserved-cpus
              value: "{{ pool.reserved_cpus }}"
            - name: cpu-manager-policy
              value: "{{ pool.cpu_manager_policy | default('static') }}"
            - name: topology-manager-policy
              value: "{{ pool.topology_manager_policy | default('single-numa-node') }}"
{% endif %}
{% endif %}
{% if pool.hugepage_count_1gb is defined and pool.hugepage_count_1gb %}
      preKubeadmCommands:
        - "echo {{ pool.hugepage_count_1gb }} > /sys/kernel/mm/hugepages/hugepages-1048576kB/nr_hugepages"
{% if pool.hugepage_count_2mb is defined and pool.hugepage_count_2mb %}
        - "echo {{ pool.hugepage_count_2mb }} > /sys/kernel/mm/hugepages/hugepages-2048kB/nr_hugepages"
{% endif %}
{% endif %}
---
apiVersion: cluster.x-k8s.io/v1beta2
kind: MachineDeployment
metadata:
  name: {{ cluster.name }}-{{ pool.name }}
  namespace: {{ cluster.namespace }}
spec:
  clusterName: {{ cluster.name }}
  replicas: {{ pool.count }}
  selector:
    matchLabels: {}
  template:
    spec:
      clusterName: {{ cluster.name }}
      version: {{ cluster.k8s_version | default('v1.29.0') }}
      bootstrap:
        configRef:
          apiGroup: bootstrap.cluster.x-k8s.io
          kind: KubeadmConfigTemplate
          name: {{ cluster.name }}-{{ pool.name }}
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: Metal3MachineTemplate
        name: {{ cluster.name }}-{{ pool.name }}
{% endfor %}
