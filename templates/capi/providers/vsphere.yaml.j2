{# Cluster API Provider vSphere (CAPV) target-cluster manifests.
   The shared CAPI-core resources (Cluster/KubeadmControlPlane/
   MachineDeployment/KubeadmConfigTemplate) target the v1beta2 contract,
   same as templates/capi/cluster-template.yaml.j2 -- see that file's
   header comment for exactly what changed from v1beta1 (apiVersion ->
   apiGroup in references, kubeletExtraArgs/extraArgs map -> list).

   VSphereCluster/VSphereMachineTemplate themselves are DELIBERATELY LEFT
   AT v1beta1 -- CAPV's own v1beta2 types only landed in CAPV v1.16
   (the immediately-preceding v1.13-v1.15 lines still use v1beta1), so
   v1beta1 remains the broadly-compatible choice today rather than
   requiring the newest possible CAPV release. See README's "Known API
   version debt" for the full picture -- this is a documented, deliberate
   choice, not an oversight matching the CAPI-core parts.

   NOTE: field names match CAPV's common v1beta1 shape -- verify against
   `kubectl explain vspheremachinetemplate.spec.template.spec` on your
   actual management cluster before relying on this in production. #}
apiVersion: cluster.x-k8s.io/v1beta2
kind: Cluster
metadata:
  name: {{ cluster.name }}
  namespace: {{ cluster.namespace }}
spec:
  clusterNetwork:
    pods:
      cidrBlocks: [{{ cluster.pod_cidr | default('192.168.0.0/16') }}]
    services:
      cidrBlocks: [{{ cluster.service_cidr | default('10.96.0.0/12') }}]
  controlPlaneRef:
    apiGroup: controlplane.cluster.x-k8s.io
    kind: KubeadmControlPlane
    name: {{ cluster.name }}-control-plane
  infrastructureRef:
    apiGroup: infrastructure.cluster.x-k8s.io
    kind: VSphereCluster
    name: {{ cluster.name }}
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta1
kind: VSphereCluster
metadata:
  name: {{ cluster.name }}
  namespace: {{ cluster.namespace }}
spec:
  server: "{{ cluster.vsphere.server | default('') }}"
  identityRef:
    kind: Secret
    name: {{ cluster.vsphere.credentials_secret | default(cluster.name ~ '-vsphere-credentials') }}
  controlPlaneEndpoint:
    host: {{ cluster.control_plane_endpoint }}
    port: {{ cluster.control_plane_port | default(6443) }}
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta1
kind: VSphereMachineTemplate
metadata:
  name: {{ cluster.name }}-control-plane
  namespace: {{ cluster.namespace }}
spec:
  template:
    spec:
      template: {{ cluster.control_plane_image }}
      cloneMode: {{ cluster.vsphere.clone_mode | default('linkedClone') }}
      datacenter: "{{ cluster.vsphere.datacenter | default('') }}"
      datastore: "{{ cluster.vsphere.datastore | default('') }}"
      resourcePool: "{{ cluster.vsphere.resource_pool | default('') }}"
      folder: "{{ cluster.vsphere.folder | default('') }}"
      diskGiB: {{ cluster.control_plane_disk_gib | default(60) }}
      numCPUs: {{ cluster.control_plane_num_cpus | default(4) }}
      memoryMiB: {{ cluster.control_plane_memory_mib | default(8192) }}
      network:
        devices:
          - networkName: "{{ cluster.vsphere.network | default('') }}"
            dhcp4: true
---
apiVersion: controlplane.cluster.x-k8s.io/v1beta2
kind: KubeadmControlPlane
metadata:
  name: {{ cluster.name }}-control-plane
  namespace: {{ cluster.namespace }}
spec:
  replicas: {{ cluster.control_plane_count | default(3) }}
  version: {{ cluster.k8s_version | default('v1.29.0') }}
  machineTemplate:
    spec:
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: VSphereMachineTemplate
        name: {{ cluster.name }}-control-plane
  kubeadmConfigSpec:
    initConfiguration:
      nodeRegistration:
        kubeletExtraArgs:
          - name: cloud-provider
            value: external
{% if cluster.control_plane_reserved_cpus is defined %}
          - name: reserved-cpus
            value: "{{ cluster.control_plane_reserved_cpus }}"
          - name: cpu-manager-policy
            value: "{{ cluster.control_plane_cpu_manager_policy | default('static') }}"
{% endif %}
    clusterConfiguration:
      apiServer:
        extraArgs:
          - name: cloud-provider
            value: external
{% if cluster.allow_workloads_on_control_plane | default(false) %}
    postKubeadmCommands:
      - "kubectl --kubeconfig /etc/kubernetes/admin.conf taint node $(hostname) node-role.kubernetes.io/control-plane- --overwrite || true"
{% endif %}
{% for pool in cluster.worker_pools %}
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta1
kind: VSphereMachineTemplate
metadata:
  name: {{ cluster.name }}-{{ pool.name }}
  namespace: {{ cluster.namespace }}
spec:
  template:
    spec:
      template: {{ pool.image }}
      cloneMode: {{ cluster.vsphere.clone_mode | default('linkedClone') }}
      datacenter: "{{ cluster.vsphere.datacenter | default('') }}"
      datastore: "{{ cluster.vsphere.datastore | default('') }}"
      resourcePool: "{{ cluster.vsphere.resource_pool | default('') }}"
      folder: "{{ cluster.vsphere.folder | default('') }}"
      network:
        devices:
          - networkName: "{{ cluster.vsphere.network | default('') }}"
            dhcp4: true
---
apiVersion: bootstrap.cluster.x-k8s.io/v1beta2
kind: KubeadmConfigTemplate
metadata:
  name: {{ cluster.name }}-{{ pool.name }}
  namespace: {{ cluster.namespace }}
spec:
  template:
    spec:
      joinConfiguration:
        nodeRegistration:
          kubeletExtraArgs:
            - name: cloud-provider
              value: external
{% if pool.node_labels is defined and pool.node_labels %}
            - name: node-labels
              value: "{{ pool.node_labels | join(',') }}"
{% endif %}
{% if pool.reserved_cpus is defined and pool.reserved_cpus %}
            - name: reserved-cpus
              value: "{{ pool.reserved_cpus }}"
{% endif %}
---
apiVersion: cluster.x-k8s.io/v1beta2
kind: MachineDeployment
metadata:
  name: {{ cluster.name }}-{{ pool.name }}
  namespace: {{ cluster.namespace }}
spec:
  clusterName: {{ cluster.name }}
  replicas: {{ pool.count }}
  selector:
    matchLabels: {}
  template:
    spec:
      clusterName: {{ cluster.name }}
      version: {{ cluster.k8s_version | default('v1.29.0') }}
      bootstrap:
        configRef:
          apiGroup: bootstrap.cluster.x-k8s.io
          kind: KubeadmConfigTemplate
          name: {{ cluster.name }}-{{ pool.name }}
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: VSphereMachineTemplate
        name: {{ cluster.name }}-{{ pool.name }}
{% endfor %}
