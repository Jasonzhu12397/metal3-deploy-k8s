{# Cluster API Provider KubeVirt (CAPK) target-cluster manifests. Targets
   VMs running as KubeVirt VirtualMachines inside an existing (management)
   Kubernetes cluster that has KubeVirt installed -- see the "kubevirt"
   addon in the catalog. This is the generic answer for "any KVM
   substrate": KubeVirt itself is libvirt/QEMU-KVM underneath, so whatever
   hosts the KubeVirt-enabled management cluster (bare metal or already-
   virtualized) is where these VMs actually run.

   The shared CAPI-core resources (Cluster/KubeadmControlPlane/
   MachineDeployment/KubeadmConfigTemplate) target the v1beta2 contract,
   same as templates/capi/cluster-template.yaml.j2 -- see that file's
   header comment for exactly what changed from v1beta1 (apiVersion ->
   apiGroup in references, kubeletExtraArgs/extraArgs map -> list).

   KubevirtCluster/KubevirtMachineTemplate themselves stay at v1alpha1 --
   CAPK has never had a v1beta1/v1beta2 for its own types (confirmed
   against the real CRD at the latest stable CAPK release: only
   v1alpha1 is served), so there's no version migration available to do
   here, unlike Metal3/CAPD.

   NOTE: CAPK's CRDs (still alpha as of this writing) are the least
   stable of the three cloud providers here -- verify field names against
   `kubectl explain kubevirtmachinetemplate.spec.template.spec` on your
   actual management cluster before relying on this in production. #}
apiVersion: cluster.x-k8s.io/v1beta2
kind: Cluster
metadata:
  name: {{ cluster.name }}
  namespace: {{ cluster.namespace }}
spec:
  clusterNetwork:
    pods:
      cidrBlocks: [{{ cluster.pod_cidr | default('192.168.0.0/16') }}]
    services:
      cidrBlocks: [{{ cluster.service_cidr | default('10.96.0.0/12') }}]
  controlPlaneRef:
    apiGroup: controlplane.cluster.x-k8s.io
    kind: KubeadmControlPlane
    name: {{ cluster.name }}-control-plane
  infrastructureRef:
    apiGroup: infrastructure.cluster.x-k8s.io
    kind: KubevirtCluster
    name: {{ cluster.name }}
---
apiVersion: infrastructure.cluster.x-k8s.io/v1alpha1
kind: KubevirtCluster
metadata:
  name: {{ cluster.name }}
  namespace: {{ cluster.namespace }}
spec:
  controlPlaneServiceTemplate:
    spec:
      type: {{ cluster.kubevirt.control_plane_service_type | default('LoadBalancer') }}
---
apiVersion: infrastructure.cluster.x-k8s.io/v1alpha1
kind: KubevirtMachineTemplate
metadata:
  name: {{ cluster.name }}-control-plane
  namespace: {{ cluster.namespace }}
spec:
  template:
    spec:
      virtualMachineTemplate:
        spec:
          runStrategy: Always
          template:
            spec:
              domain:
                cpu:
                  cores: {{ cluster.control_plane_num_cpus | default(4) }}
                memory:
                  guest: {{ cluster.control_plane_memory_mib | default(8192) }}Mi
                devices: {}
              volumes:
                - name: {{ cluster.name }}-control-plane-boot
                  dataVolume:
                    name: {{ cluster.control_plane_image }}
              accessCredentials: []
          dataVolumeTemplates:
            - metadata:
                name: {{ cluster.name }}-control-plane-boot
              spec:
                storage:
                  storageClassName: "{{ cluster.kubevirt.storage_class_name | default('') }}"
                source:
                  registry:
                    url: {{ cluster.control_plane_image }}
---
apiVersion: controlplane.cluster.x-k8s.io/v1beta2
kind: KubeadmControlPlane
metadata:
  name: {{ cluster.name }}-control-plane
  namespace: {{ cluster.namespace }}
spec:
  replicas: {{ cluster.control_plane_count | default(3) }}
  version: {{ cluster.k8s_version | default('v1.29.0') }}
  machineTemplate:
    spec:
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: KubevirtMachineTemplate
        name: {{ cluster.name }}-control-plane
  kubeadmConfigSpec:
    initConfiguration:
      nodeRegistration:
        kubeletExtraArgs:
          - name: cloud-provider
            value: ""
{% if cluster.control_plane_reserved_cpus is defined %}
          - name: reserved-cpus
            value: "{{ cluster.control_plane_reserved_cpus }}"
          - name: cpu-manager-policy
            value: "{{ cluster.control_plane_cpu_manager_policy | default('static') }}"
{% endif %}
    clusterConfiguration:
      apiServer:
        extraArgs:
          - name: cloud-provider
            value: ""
{% if cluster.allow_workloads_on_control_plane | default(false) %}
    postKubeadmCommands:
      - "kubectl --kubeconfig /etc/kubernetes/admin.conf taint node $(hostname) node-role.kubernetes.io/control-plane- --overwrite || true"
{% endif %}
{% for pool in cluster.worker_pools %}
---
apiVersion: infrastructure.cluster.x-k8s.io/v1alpha1
kind: KubevirtMachineTemplate
metadata:
  name: {{ cluster.name }}-{{ pool.name }}
  namespace: {{ cluster.namespace }}
spec:
  template:
    spec:
      virtualMachineTemplate:
        spec:
          runStrategy: Always
          template:
            spec:
              domain:
                cpu:
                  cores: {{ pool.num_cpus | default(4) }}
                memory:
                  guest: {{ pool.memory_mib | default(8192) }}Mi
                devices: {}
              volumes:
                - name: {{ cluster.name }}-{{ pool.name }}-boot
                  dataVolume:
                    name: {{ pool.image }}
          dataVolumeTemplates:
            - metadata:
                name: {{ cluster.name }}-{{ pool.name }}-boot
              spec:
                storage:
                  storageClassName: "{{ cluster.kubevirt.storage_class_name | default('') }}"
                source:
                  registry:
                    url: {{ pool.image }}
---
apiVersion: bootstrap.cluster.x-k8s.io/v1beta2
kind: KubeadmConfigTemplate
metadata:
  name: {{ cluster.name }}-{{ pool.name }}
  namespace: {{ cluster.namespace }}
spec:
  template:
    spec:
      joinConfiguration:
        nodeRegistration:
          kubeletExtraArgs:
            - name: cloud-provider
              value: ""
{% if pool.node_labels is defined and pool.node_labels %}
            - name: node-labels
              value: "{{ pool.node_labels | join(',') }}"
{% endif %}
{% if pool.reserved_cpus is defined and pool.reserved_cpus %}
            - name: reserved-cpus
              value: "{{ pool.reserved_cpus }}"
{% endif %}
---
apiVersion: cluster.x-k8s.io/v1beta2
kind: MachineDeployment
metadata:
  name: {{ cluster.name }}-{{ pool.name }}
  namespace: {{ cluster.namespace }}
spec:
  clusterName: {{ cluster.name }}
  replicas: {{ pool.count }}
  selector:
    matchLabels: {}
  template:
    spec:
      clusterName: {{ cluster.name }}
      version: {{ cluster.k8s_version | default('v1.29.0') }}
      bootstrap:
        configRef:
          apiGroup: bootstrap.cluster.x-k8s.io
          kind: KubeadmConfigTemplate
          name: {{ cluster.name }}-{{ pool.name }}
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: KubevirtMachineTemplate
        name: {{ cluster.name }}-{{ pool.name }}
{% endfor %}
